# ============================================================
# Vercel Environment Variables
# Copy these into Vercel Dashboard → Project → Settings → Environment Variables
# ============================================================

# REQUIRED: Your MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/fraud_detection_system?retryWrites=true&w=majority

# REQUIRED: A strong random secret for JWT signing (generate one at: https://generate-secret.vercel.app/64)
JWT_SECRET=your_super_strong_jwt_secret_here_min_32_chars

# REQUIRED: Set to production
NODE_ENV=production

# OPTIONAL: JWT token expiry (default 24h)
JWT_EXPIRES_IN=24h

# OPTIONAL: Your Vercel app URL (e.g. https://fraud-detection-system.vercel.app)
CLIENT_ORIGIN=https://your-project-name.vercel.app
